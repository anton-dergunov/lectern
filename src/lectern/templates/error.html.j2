{% extends "page.html.j2" %}

{% block head %}
{% if retry %}
<meta http-equiv="refresh" content="{{ retry }}">
{% endif %}
{% endblock %}

{% block main %}
<main class="listing" data-error>
<h1>{{ heading }}</h1>
<p class="empty">{{ message }}</p>
{% if detail %}
<pre class="error">{{ detail }}</pre>
{% endif %}
{# reader.js points "Go back" at the page the reader came from, as it does the chevron. #}
<p class="actions">
  <a class="action" href="{{ back }}" data-back>Go back</a>
  <a class="action" href="/_home">Open {{ start }}</a>
</p>
</main>
{% endblock %}
