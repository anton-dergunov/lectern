{% extends "page.html.j2" %}

{% macro row(entry, show_path=false) %}
<li><a class="row" href="{{ entry.href }}">
  <span class="row-title">{{ entry.title }}</span>
  <span class="meta">{{ entry.path if show_path else entry.name }}{% if not static_site %} · {{ entry.modified }}{% endif %}</span>
</a></li>
{% endmacro %}

{% macro files(listing) %}
<div class="files-view">
<ul class="rows">
{% for folder in listing.folders %}
<li><a class="row" href="{{ folder.href }}">
  <span class="row-title"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 7.5V18a1.5 1.5 0 0 0 1.5 1.5h15A1.5 1.5 0 0 0 21 18V9a1.5 1.5 0 0 0-1.5-1.5h-7.4L10 5H4.5A1.5 1.5 0 0 0 3 6.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>{{ folder.name }}/</span>
  <span class="meta">{{ folder.documents }} document{{ "" if folder.documents == 1 else "s" }}</span>
</a></li>
{% endfor %}
{% for entry in listing.here %}
<li><a class="row" href="{{ entry.href }}">
  <span class="row-title">{{ entry.name }}</span>
  <span class="meta">{{ entry.modified }}</span>
</a></li>
{% endfor %}
</ul>
</div>
{% endmacro %}

{% block main %}
<main class="listing">
{# A built site has a page for each document but none for a folder, so it has only the
   overview. The switch is shown by reader.js, which is what remembers the choice. #}
{% set switchable = listing is defined and listing.groups and not static_site %}
{% if switchable %}
<div class="listing-head">
<h1>{{ heading }}</h1>
<div class="choice view-switch" data-view-switch hidden>
  <button type="button" data-pref="listing" data-value="overview">Overview</button>
  <button type="button" data-pref="listing" data-value="files">Files</button>
</div>
</div>
{% else %}
<h1>{{ heading }}</h1>
{% endif %}
{% if description %}
<p class="lede">{{ description }}</p>
{% endif %}
{% if roots is defined and not roots %}
<p class="empty">No folders are being served. On your Mac, run <code>lectern add</code> in a folder you want to read.</p>
{% elif roots is defined %}
<ul class="rows">
{% for root in roots %}
<li><a class="row" href="{{ root.href }}"><span class="row-title">{{ root.name }}</span></a></li>
{% endfor %}
</ul>
{% elif not listing.groups %}
<p class="empty">No notebooks or markdown files here.</p>
{% else %}
{% if switchable %}{{ files(listing) }}{% endif %}
<div class="overview">
{% if listing.recent %}
<section class="group">
<h2>Recently changed</h2>
<ul class="rows">
{% for entry in listing.recent %}{{ row(entry, show_path=true) }}{% endfor %}
</ul>
</section>
{% endif %}
{% for group in listing.groups %}
<section class="group">
{% if group.name and static_site %}
<h2>{{ group.name }}</h2>
{% elif group.name %}
<h2><a href="{{ group.href }}">{{ group.name }}</a></h2>
{% elif listing.recent or listing.groups | length > 1 %}
<h2>This folder</h2>
{% endif %}
{% for entry in group.notebooks %}
<article class="card">
  <a class="card-link" href="{{ entry.href }}">
    <span class="card-title">{{ entry.title }}</span>
{% if entry.summary %}
    <span class="card-summary">{{ entry.summary }}</span>
{% endif %}
  </a>
  <p class="meta">{{ entry.name }} · {{ entry.minutes }} min{% if not static_site %} · {{ entry.modified }}{% endif %}{% if source %} · <a href="{{ source }}/{{ entry.path | urlencode }}">Notebook on GitHub</a>{% endif %}</p>
</article>
{% endfor %}
{% if group.pages %}
<ul class="rows">
{% for entry in group.pages %}{{ row(entry) }}{% endfor %}
</ul>
{% endif %}
</section>
{% endfor %}
</div>
{% endif %}
</main>
{% endblock %}
