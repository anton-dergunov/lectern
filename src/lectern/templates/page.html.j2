<!doctype html>
<html lang="en" data-theme="solarized-light" data-width="m"{% if static_site %} data-static{% endif %}{% if default_family %} data-default-family="{{ default_family }}"{% endif %}>
<head>
<meta charset="utf-8">
{% if csp %}
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
{% endif %}
<title>{{ title }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Lectern">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="theme-color" content="{{ theme_color }}">
<meta name="format-detection" content="telephone=no">
{% block head %}{% endblock %}
{% if not static_site %}
<link rel="manifest" href="/manifest.webmanifest">
{% endif %}
<link rel="apple-touch-icon" sizes="180x180" href="{{ static }}/icons/apple-touch-icon.png">
<link rel="icon" type="image/svg+xml" href="{{ static }}/icons/icon.svg">
<link rel="stylesheet" href="{{ static }}/themes.css{{ version }}">
<link rel="stylesheet" href="{{ static }}/reader.css{{ version }}">
<link rel="stylesheet" href="{{ static }}/pygments.css{{ version }}">
{# Only on pages that have math: KaTeX is larger than everything else on the page together. #}
{% if math %}
<link rel="stylesheet" href="{{ static }}/vendor/katex/katex.min.css{{ version }}">
<script src="{{ static }}/vendor/katex/katex.min.js{{ version }}" defer></script>
{% endif %}
<script src="{{ static }}/boot.js{{ version }}"></script>
<script src="{{ static }}/reader.js{{ version }}" defer></script>
</head>
<body>
{% block body %}
<header class="bar">
{% if back %}
  <a class="bar-button back" href="{{ back }}" aria-label="Back to {{ crumbs[-1].name if crumbs else 'the listing' }}">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
{% endif %}
  <nav class="crumbs" aria-label="Location">
{% for crumb in crumbs %}
    <a href="{{ crumb.href }}">{{ crumb.name }}</a>{% if not loop.last or here %}<span class="sep" aria-hidden="true">/</span>{% endif %}

{% endfor %}
{% if here %}
    <span class="here" aria-current="page" title="{{ here }}">{{ here }}</span>
{% endif %}
  </nav>
{% if toc and toc | length > 1 %}
  <button class="bar-button" type="button" data-open="toc" aria-label="Contents">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  </button>
{% endif %}
  <button class="bar-button" type="button" data-open="settings" aria-label="Reading settings">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 18l4.5-12h1L13 18M4.6 14h6.8M15.5 18l2.7-7h.6l2.7 7M16.5 15.6h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</header>
{% block main %}
{% if stale %}
<p class="banner">This file could not be read just now, probably because it is being saved. Showing the last version that could.</p>
{% endif %}
<main class="doc" data-path="{{ path }}" data-mtime="{{ mtime }}">
{{ fragment | safe }}
</main>
{% endblock %}

{% if toc and toc | length > 1 %}
<dialog class="sheet" id="toc" aria-label="Contents">
  <div class="sheet-panel" tabindex="-1" autofocus>
    <header class="sheet-head"><h2>Contents</h2><button type="button" data-close>Done</button></header>
    {# Shown by the script, which is what folds sections. #}
    <div class="choice" data-folds hidden>
      <button type="button" data-fold-all="true">Collapse all</button>
      <button type="button" data-fold-all="false">Expand all</button>
    </div>
    <nav class="toc">
{% for heading in toc %}
      <a class="toc-{{ heading.level }}" href="#{{ heading.id | urlencode }}">{{ heading.text }}</a>
{% endfor %}
    </nav>
  </div>
</dialog>
{% endif %}

{# Shown only in the e-ink theme, where turning pages replaces scrolling. #}
<footer class="pager">
  <button type="button" data-turn="start">Start</button>
  <button type="button" data-turn="-1">Previous</button>
  <output data-page title="Tap to hide or show the top bar"></output>
  <button type="button" data-turn="1">Next</button>
  <button type="button" data-turn="end">End</button>
</footer>

<dialog class="sheet" id="settings" aria-label="Reading settings">
  <div class="sheet-panel" tabindex="-1" autofocus>
    <header class="sheet-head"><h2>Reading</h2><button type="button" data-close>Done</button></header>
    <section class="setting">
      <h3>Text size</h3>
      <div class="stepper">
        <button type="button" data-size-step="-1" aria-label="Smaller text">−</button>
        <output data-size-value>19 px</output>
        <button type="button" data-size-step="1" aria-label="Larger text">+</button>
      </div>
    </section>
    <section class="setting" data-width-setting>
      <h3>Column width</h3>
      <div class="choice">
        <button type="button" data-pref="width" data-value="n">Narrow</button>
        <button type="button" data-pref="width" data-value="m">Medium</button>
        <button type="button" data-pref="width" data-value="w">Wide</button>
        <button type="button" data-pref="width" data-value="x">Wider</button>
        <button type="button" data-pref="width" data-value="f">Full</button>
      </div>
    </section>
    <section class="setting">
      <h3>Colours</h3>
      <div class="choice">
        <button type="button" data-pref="family" data-value="solarized">Solarized</button>
        <button type="button" data-pref="family" data-value="plain">Black &amp; white</button>
        <button type="button" data-pref="family" data-value="eink">E-ink</button>
      </div>
      <div class="choice" data-inks>
        <button type="button" data-pref="ink" data-value="mono">Black only</button>
        <button type="button" data-pref="ink" data-value="colour">With colour</button>
      </div>
      <div class="choice" data-modes>
        <button type="button" data-pref="mode" data-value="light">Light</button>
        <button type="button" data-pref="mode" data-value="dark">Dark</button>
        <button type="button" data-pref="mode" data-value="system">Follow system</button>
      </div>
    </section>
    <section class="setting">
      <h3>Code cells</h3>
      <div class="choice">
        <button type="button" data-pref="hideCode" data-value="false">Shown</button>
        <button type="button" data-pref="hideCode" data-value="true">Hidden</button>
      </div>
    </section>
    <section class="setting" data-follow-setting>
      <h3>When the notebook is saved again</h3>
      <div class="choice">
        <button type="button" data-pref="follow" data-value="false">Stay as it is</button>
        <button type="button" data-pref="follow" data-value="true">Show the new version</button>
      </div>
    </section>
    <p class="sheet-note">Saved on this device.</p>
  </div>
</dialog>
{% endblock %}
</body>
</html>
